#!/usr/bin/make -f
# -*- makefile -*-

export ROS_DISTRO:=@ROS_DISTRO@
export ROS_PYTHON_VERSION:=3
export PYTHONPATH:=/opt/ros/${ROS_DISTRO}/lib/python3/dist-packages:/opt/ros/${ROS_DISTRO}/lib/python$(shell python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}');")/site-packages:/opt/ros/${ROS_DISTRO}/local/lib/python$(shell python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}');")/dist-packages:$(PYTHONPATH)
export PKG_CONFIG_PATH:=/opt/ros/${ROS_DISTRO}/lib/pkgconfig:$(PKG_CONFIG_PATH)
export AMENT_PREFIX_PATH:=/opt/ros/${ROS_DISTRO}
export CMAKE_PREFIX_PATH:=/opt/ros/${ROS_DISTRO}

TMP = $(CURDIR)/debian/tmp
CMAKE_FLAGS = -DPYTHON_DEB_ROOT=$(TMP)

%:
	dh $@ --no-parallel

override_dh_auto_configure:
	dh_auto_configure --builddirectory=debian/build/libmc-rtc-ros-compat -- -DDISABLE_ROS=ON -DFETCHCONTENT_FULLY_DISCONNECTED=OFF $(CMAKE_FLAGS)
	dh_auto_configure --builddirectory=debian/build/libmc-rtc-ros-compat-dev -- -DDISABLE_ROS=ON -DFETCHCONTENT_FULLY_DISCONNECTED=OFF $(CMAKE_FLAGS)
	dh_auto_configure --builddirectory=debian/build/ros-@ROS_DISTRO@-mc-rtc-ros-compat -- -DDISABLE_ROS=OFF -DFETCHCONTENT_FULLY_DISCONNECTED=OFF $(CMAKE_FLAGS)

override_dh_auto_build:
	dh_auto_build --builddirectory=debian/build/libmc-rtc-ros-compat
	dh_auto_build --builddirectory=debian/build/libmc-rtc-ros-compat-dev
	dh_auto_build --builddirectory=debian/build/ros-@ROS_DISTRO@-mc-rtc-ros-compat

override_dh_auto_install:
	dh_auto_install --builddirectory=debian/build/libmc-rtc-ros-compat --destdir=debian/tmp-libmc-rtc-ros-compat
	dh_auto_install --builddirectory=debian/build/libmc-rtc-ros-compat-dev --destdir=debian/tmp-libmc-rtc-ros-compat-dev
	dh_auto_install --builddirectory=debian/build/ros-@ROS_DISTRO@-mc-rtc-ros-compat --destdir=debian/tmp-ros-@ROS_DISTRO@-mc-rtc-ros-compat

override_dh_install:
	dh_install -plibmc-rtc-ros-compat --sourcedir=debian/tmp-libmc-rtc-ros-compat
	dh_install -plibmc-rtc-ros-compat-dev --sourcedir=debian/tmp-libmc-rtc-ros-compat-dev
	dh_install -pros-@ROS_DISTRO@-mc-rtc-ros-compat --sourcedir=debian/tmp-ros-@ROS_DISTRO@-mc-rtc-ros-compat

override_dh_clean:
	dh_clean
	rm -rf debian/build
